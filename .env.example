# Public browser-safe Supabase configuration.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only Supabase key. Never expose this to browser code.
SUPABASE_SERVICE_ROLE_KEY=

# Public app/deployment metadata used by /api/version.
NEXT_PUBLIC_APP_URL=http://localhost:3000
VERCEL_ENV=development
VERCEL_GIT_COMMIT_SHA=

# Landing waitlist integration.
MAILERLITE_API_KEY=
MAILERLITE_GROUP_NAME=Caniello Waitlist

# Deferred billing and analytics placeholders.
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
NEXT_PUBLIC_ANALYTICS_ENABLED=false
