{
  "name": "caniello",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@9.15.4",
  "engines": {
    "node": "24.x",
    "pnpm": "9.15.4"
  },
  "scripts": {
    "dev": "turbo dev --filter=web",
    "build": "turbo build",
    "doctor": "node scripts/doctor.mjs",
    "format:check": "node scripts/format-check-changed.mjs",
    "lint": "eslint .",
    "smoke": "node scripts/smoke.mjs",
    "validation:mailerlite-integration": "node scripts/mailerlite-integration-gate.mjs",
    "validation:repo-hygiene": "node --test scripts/repo-hygiene-gate.test.mjs && node scripts/repo-hygiene-gate.mjs",
    "test": "turbo test",
    "test:e2e": "turbo test:e2e --filter=web",
    "typecheck": "turbo typecheck",
    "validation:platform-foundation": "node scripts/platform-foundation-gate.mjs",
    "validation:task-contract": "node --test scripts/task-contract-gate.test.mjs && node scripts/task-contract-gate.mjs",
    "verify:fast": "node scripts/verify.mjs fast",
    "verify": "node scripts/verify.mjs full"
  },
  "devDependencies": {
    "@playwright/test": "1.60.0",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.2",
    "@testing-library/user-event": "14.6.1",
    "@types/node": "25.9.1",
    "@types/react": "19.2.15",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "autoprefixer": "10.5.0",
    "eslint": "9.39.2",
    "eslint-config-next": "16.2.6",
    "jsdom": "29.1.1",
    "postcss": "8.5.15",
    "prettier": "3.8.3",
    "supabase": "2.100.1",
    "tailwindcss": "3.4.17",
    "turbo": "2.9.14",
    "typescript": "6.0.3",
    "vitest": "4.1.7"
  }
}
